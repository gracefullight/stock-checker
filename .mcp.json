{
  "mcpServers": {
    "serena": {
      "command": "oma",
      "args": [
        "bridge",
        "--context",
        "oma"
      ],
      "env": {
        "SERENA_LOG_LEVEL": "info"
      }
    },
    "stock_checker": {
      "command": "mise",
      "args": [
        "--quiet",
        "run",
        "mcp"
      ],
      "env": {
        "FMP_API_KEY": "${FMP_API_KEY:-}",
        "TIINGO_API_KEY": "${TIINGO_API_KEY:-}"
      }
    },
    "aside": {
      "command": "aside",
      "args": [
        "mcp"
      ]
    }
  }
}
