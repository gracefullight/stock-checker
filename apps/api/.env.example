PORT=5101
NODE_ENV=development

# Slack webhook (optional)
SLACK_WEBHOOK_URL=

# Optional Meta WhatsApp Cloud API notifications (also usable by CLI/MCP).
# Approved template body must have exactly 3 text variables: title, as-of, summary.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TO=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en_US
# Set the supported vN.N version shown in your Meta app.
WHATSAPP_GRAPH_API_VERSION=
