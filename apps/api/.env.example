PORT=5101
NODE_ENV=development

# Bind address. The API has no authentication, so it listens on loopback by
# default; set 0.0.0.0 only on a trusted network (writes still require the
# dashboard origin or a loopback client).
API_HOST=127.0.0.1

# Browser origin allowed to call the API. Defaults to the local dashboard
# (http://localhost:5100, http://127.0.0.1:5100, http://[::1]:5100).
CORS_ORIGIN=http://localhost:5100

# Slack webhook (optional)
SLACK_WEBHOOK_URL=

# Optional local WhatsApp Web notifications (also usable by CLI/MCP).
# Link with mise run whatsapp:link, then keep mise run whatsapp:gateway running.
# Recipient must use E.164 format (+ and country code).
WHATSAPP_TO=
WHATSAPP_GATEWAY_URL=http://127.0.0.1:5102
# Optional explicit token; otherwise read AUTH_DIR/gateway-token (private 0600 file).
WHATSAPP_GATEWAY_TOKEN=
# Empty uses repository-root data/whatsapp/; keep custom session directories private.
WHATSAPP_AUTH_DIR=
# Gateway process only; if changed, update WHATSAPP_GATEWAY_URL too.
WHATSAPP_GATEWAY_PORT=5102
