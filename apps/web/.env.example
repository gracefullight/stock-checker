# Fastify API origin used by the Next server (SSR fetches and the /api proxy).
# apps/api listens on 5101 by default (`mise run dev:api`).
API_URL=http://localhost:5101

# Optional: make the browser call the API directly instead of the same-origin
# /api proxy. Leave unset for normal local use.
# NEXT_PUBLIC_API_URL=http://localhost:5101
