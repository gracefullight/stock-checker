{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bootstrap-sha": "e418ac28d31f02dc6c2956f0dc10536897f4fb65",
  "separate-pull-requests": true,
  "packages": {
    ".": {
      "release-type": "node",
      "include-component-in-tag": false,
      "initial-version": "0.1.0",
      "bump-minor-pre-major": false,
      "bump-patch-for-minor-pre-major": false,
      "changelog-sections": [
        { "type": "feat", "section": "Features" },
        { "type": "fix", "section": "Bug Fixes" },
        { "type": "perf", "section": "Performance" },
        { "type": "refactor", "section": "Refactoring" },
        { "type": "docs", "section": "Documentation" },
        { "type": "test", "section": "Tests" },
        { "type": "build", "section": "Build System" },
        { "type": "ci", "section": "Continuous Integration" },
        { "type": "chore", "section": "Maintenance" },
        { "type": "style", "section": "Style" },
        { "type": "revert", "section": "Reverts" }
      ],
      "extra-files": [
        { "type": "json", "path": "packages/core/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "apps/api/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "apps/web/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "apps/mcp/package.json", "jsonpath": "$.version" }
      ]
    }
  }
}
