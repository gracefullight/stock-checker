{
  "name": "stock-checker",
  "version": "0.7.11",
  "private": true,
  "imports": {
    "#scripts/*": "./.github/scripts/*"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare": "if command -v mise >/dev/null 2>&1; then mise run hooks:install; else echo 'mise not found; skipping git hooks install'; fi"
  },
  "engines": {
    "node": "26",
    "bun": ">=1.4.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@gracefullight/biome-plugin": "^0.2.3",
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/ui": "^5.0.3",
    "msw": "^3.0.2",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.3"
  },
  "patchedDependencies": {
    "@whiskeysockets/baileys@7.0.0-rc14": "patches/@whiskeysockets%2Fbaileys@7.0.0-rc14.patch"
  }
}
