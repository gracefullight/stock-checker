{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "name": "oma-hook-UserPromptSubmit",
            "type": "command",
            "command": "\"$GROK_WORKSPACE_ROOT/.grok/hooks/oma-hook.sh\" --vendor 'grok' --event 'UserPromptSubmit'",
            "timeout": 21
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "name": "oma-hook-PreToolUse",
            "type": "command",
            "command": "\"$GROK_WORKSPACE_ROOT/.grok/hooks/oma-hook.sh\" --vendor 'grok' --event 'PreToolUse' --matcher 'Bash|hashline_edit|apply_patch|create_file|write_file|edit_file|str_replace'",
            "timeout": 26
          }
        ],
        "matcher": "Bash|hashline_edit|apply_patch|create_file|write_file|edit_file|str_replace"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "name": "oma-hook-PostToolUse",
            "type": "command",
            "command": "\"$GROK_WORKSPACE_ROOT/.grok/hooks/oma-hook.sh\" --vendor 'grok' --event 'PostToolUse' --matcher 'search_replace|write|hashline_edit|apply_patch|create_file|write_file|edit_file|str_replace|read_file|hashline_read|run_terminal_command|run_terminal_cmd'",
            "timeout": 24
          }
        ],
        "matcher": "search_replace|write|hashline_edit|apply_patch|create_file|write_file|edit_file|str_replace|read_file|hashline_read|run_terminal_command|run_terminal_cmd"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "name": "oma-hook-Stop",
            "type": "command",
            "command": "\"$GROK_WORKSPACE_ROOT/.grok/hooks/oma-hook.sh\" --vendor 'grok' --event 'Stop'",
            "timeout": 40
          }
        ]
      }
    ]
  }
}
